root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# LilyPond source and include files
[*.{ly,ily}]
indent_style = space
indent_size = 4

# Markdown documentation
[*.md]
trim_trailing_whitespace = false

# Makefiles: recipe lines require literal tab characters
[Makefile]
indent_style = tab
indent_size = tab
tab_width = 4

# Shell scripts
[*.sh]
indent_style = space
indent_size = 4

# YAML (GitHub Actions workflows)
[*.{yml,yaml}]
indent_style = space
indent_size = 4

# JSON
[*.json]
indent_style = space
indent_size = 4
