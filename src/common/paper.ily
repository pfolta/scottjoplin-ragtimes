\version "2.26.0"
\language "english"

\paper {
    #(set-paper-size "a4")

    % Use the same margins and line width in the book and the sheet music.
    top-margin = 15\mm
    bottom-margin = 15\mm
    line-width = 170\mm

    % Stretch score systems to use the full page height on all pages.
    ragged-bottom = ##f
    ragged-last-bottom = ##f
}
