\version "2.26.0"
\language "english"

\paper {
    #(set-paper-size "a4")

    % Sheets are single-sided.
    two-sided = ##f
    left-margin = 10
    right-margin = 10
    top-margin = 10
    bottom-margin = 10

    % Stretch score systems to use the full page height on all pages.
    ragged-bottom = ##f
    ragged-last-bottom = ##f
}
