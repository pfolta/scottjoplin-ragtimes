\version "2.26.0"
\language "english"

original-rags-edits = \markup {
    \column {
        \column-lines {
            \line \bold { "Title:" }
            \line { \concat { \italic "Picked by SCOTT JOPLIN." " omitted." } }
            \line { \concat { \italic "Arranged by CHAS. N. DANIELS." " omitted." } }
            \line { \null }

            \line \bold { "Measure 20, upper staff, first note:" }
            \line { \concat { "Accent (" \smufl-accent ") added (cf. measure 73)." } }
            \line { \null }

            \line \bold { "Measure 33, lower staff, all notes:" }
            \line { \concat { "Accent (" \smufl-accent ") added (cf. measure 31)." } }
            \line { \null }

            \line \bold { "Measures 64 and 72, upper staff, third note:" }
            \line { "E5 sixteenth note added." }
            \line { \null }

            \line \bold { "Measure 65, upper staff, first note:" }
            \line { \concat { "Accent (" \smufl-accent ") added (cf. measure 12)." } }
            \line { \null }

            \line \bold { "Measure 69, upper staff, last two notes:" }
            \line { \concat { "Accent (" \smufl-accent ") added (cf. measure 16)." } }
            \line { \null }

            \line \bold { "Measure 82, lower staff, second note:" }
            \line { \concat { "F" \super \smufl-sharp "3 omitted (cf. measure 83)." } }
            \line { \null }

            \line \bold { "Measure 85:" }
            \line { "Decrescendo hairpin added (cf. measure 81)." }
            \line { \null }
        }
    }
}
