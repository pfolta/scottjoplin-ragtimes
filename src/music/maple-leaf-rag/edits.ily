maple-leaf-rag-edits = \markuplist {
    \column-lines {
        \justified-lines \bold { Measure 41, lower staff: }
        \justified-lines { Slurs added (cf. measure 7). }
        \line { \null }

        \justified-lines \bold { Measure 42, upper staff: }
