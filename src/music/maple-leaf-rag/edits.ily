\version "2.26.0"
\language "english"

maple-leaf-rag-edits = \markup {
    \column {
        \column-lines {
            \line \bold { "Dedication:" }
            \line { "Only on the cover of the second edition (1901)." }
            \line { \null }

            \line \bold { "Measure 7, lower staff:" }
            \line { "Slurs moved above the notes." }
            \line { \null }

            \line \bold { "Measure 41, lower staff:" }
            \line { "Slurs added (cf. measure 7)." }
            \line { \null }

            \line \bold { "Measure 42, upper staff:" }
            \line { "Slurs added (cf. measure 8)." }
            \line { \null }

            \line \bold { "Measure 46, lower staff, third note:" }
            \line { \concat { "E" \super \smufl-flat "4 omitted (cf. measure 12)." } }
            \line { \null }

            \line \bold { "Measure 51:" }
            \line { \concat { \italic \f-paren " added." } }
            \line { \null }

            \line \bold { "Measure 68:" }
            \line { \concat { \italic \f-paren " added." } }
        }
    }
}
