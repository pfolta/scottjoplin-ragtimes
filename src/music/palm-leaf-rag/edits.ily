\version "2.26.0"
\language "english"

palm-leaf-rag-edits = \markup {
    \column {
        \column-lines {
            \line \bold { "Title:" }
            \line { \concat { \italic "A Slow Drag" " appears on the cover only." } }
            \line { \concat { \italic "Composer of “Maple Leaf Rag”" " omitted." } }
            \line { \null }

            \line \bold { "Measure 16, upper staff, fourth note:" }
            \line { "Natural sign added." }
            \line { \null }

            \line \bold { "Measure 34, upper staff, first note:" }
            \line { "Double-dotted note changed to single-dotted note." }
            \line { \null }

            \line \bold { "Measure 36, upper staff, last note:" }
            \line { "Natural sign added." }
            \line { \null }

            \line \bold { "Measure 40, upper staff, last note:" }
            \line { "Flat sign added." }
            \line { \null }

            \line \bold { "Measure 45, upper staff, first note:" }
            \line { "Natural sign added." }
            \line { \null }

            \line \bold { "Measure 48, upper staff, last note:" }
            \line { "Flat sign added." }
            \line { \null }

            \line \bold { "Measure 53, upper staff, third note:" }
            \line { "Flat sign added." }
            \line { \null }

            \line \bold { "Measure 53, upper staff, fifth note:" }
            \line { "Natural sign added." }
            \line { \null }

            \line \bold { "Measure 56, lower staff:" }
            \line { "Slur moved below the notes." }
            \line { \null }

            \line \bold { "Measure 57, upper staff, third note:" }
            \line { "Natural sign added." }
            \line { \null }

            \line \bold { "Measure 58, upper staff, fourth note:" }
            \line { "Natural sign added." }
            \line { \null }

            \line \bold { "Measure 67, lower staff, third note:" }
            \line { "Marcato moved above the note (cf. measure 12)." }
            \line { \null }

            \line \bold { "Measure 71, upper staff, fourth note:" }
            \line { "Natural sign added (cf. measure 16)." }
            \line { \null }
        }
    }
}
