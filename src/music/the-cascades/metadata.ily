the-cascades-tagline = \markuplist { First published by \italic { John Stark & Son } "(St. Louis," Mo.) in 1904. }

the-cascades-source-label = \markuplist { Indiana University Sheet Music Collections }
the-cascades-source-url = "https://purl.dlib.indiana.edu/iudl/lilly/devincent/LL-SDV-042058"

the-cascades-header = \header {
    dedication = \markup \the-cascades-dedication
    title = \the-cascades-title
    subtitle = \markup \the-cascades-subtitle

    composer = \the-cascades-composer

    tagline = \markup \the-cascades-tagline
