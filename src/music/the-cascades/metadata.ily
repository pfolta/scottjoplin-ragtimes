\version "2.26.0"
\language "english"

the-cascades-output-name = "The Cascades"

the-cascades-index = "Cascades, The"

the-cascades-dedication = \markuplist { Respectfully Dedicated to Kimball and Donovan, Banjoists }
the-cascades-title = "The Cascades"
the-cascades-subtitle = \markuplist { A Rag }

the-cascades-composer = "Scott Joplin"

the-cascades-publication-publisher = "John Stark & Son"
the-cascades-publication-place = "St. Louis, Mo."
