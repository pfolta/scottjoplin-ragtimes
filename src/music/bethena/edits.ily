\version "2.26.0"
\language "english"

bethena-edits = \markup {
    \column {
        \column-lines {
            \line \bold { "Title:" }
            \line { "The dedication is printed on the cover only." }
            \line { \concat { \italic "Composer of “Maple Leaf Rag”" " omitted." } }
            \line { \null }

            \line \bold { "Measure 77, upper staff:" }
            \line { "Slurs moved below the notes." }
            \line { \null }

            \line \bold { "Measure 85, upper staff:" }
            \line { "Slurs moved below the notes (cf. measure 77)." }
            \line { \null }

            \line \bold { "Measure 97, across both staves:" }
            \line { "Slur reshaped." }
            \line { \null }
        }
    }
}
