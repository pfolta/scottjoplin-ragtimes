\version "2.26.0"
\language "english"

weeping-willow-edits = \markup {
    \column {
        \column-lines {
            \line \bold { "Title:" }
            \line { "The dedication is printed on the cover only." }
            \line { \null }

            \line \bold { "Measures 1 and 2:" }
            \line { "Lower voice assigned to the lower staff." }
            \line { \null }

            \line \bold { "Measure 12, upper staff, last note:" }
            \line { "A4 changed to B4 (cf. measure 46)." }
            \line { \null }

            \line \bold { "Measures 15, 41 and 49, lower staff:" }
            \line { "C3 quarter notes added (cf. measure 7)." }
            \line { \null }

            \line \bold { "Measure 15, lower staff, last note:" }
            \line { \concat { "E3 changed to E" \super \smufl-flat "3 (cf. measures 7, 41 and 49)." } }
            \line { \null }
        }
    }
}
