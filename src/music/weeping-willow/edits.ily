\version "2.26.0"
\language "english"

weeping-willow-edits = \markuplist {
    \column-lines {
        \line \bold { "Measure 12, upper staff, last note:" }
        \line { "A4 changed to B4 (cf. measure 46)." }
        \line { \null }

        \line \bold { "Measure 15, lower staff:" }
        \line { "C3 quarter notes added (cf. measure 7)." }
        \line { \null }

        \line \bold { "Measure 15, lower staff, last note:" }
        \line { \concat { "E3 changed to E" \super \smufl-flat "3 (cf. measures 7, 41 and 49)." } }
        \line { \null }

        \line \bold { "Measure 41, lower staff:" }
        \line { "C3 quarter notes added (cf. measure 7)." }
        \line { \null }

        \line \bold { "Measure 49, lower staff:" }
        \line { "C3 quarter notes added (cf. measure 7)." }
    }
}
