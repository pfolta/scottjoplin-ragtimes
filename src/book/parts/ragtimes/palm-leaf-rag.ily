\version "2.26.0"
\language "english"

\bookpart {
    \label #'ragtimes.palm-leaf-rag
    \tocItem ragtimes.palm-leaf-rag \palm-leaf-rag-title
    \pdf-bookmark "ragtimes.palm-leaf-rag" \palm-leaf-rag-title #0

    \palm-leaf-rag-header

    \score {
        \keepWithTag #'layout {
            \palm-leaf-rag-score
        }

        \layout {}
    }
}
