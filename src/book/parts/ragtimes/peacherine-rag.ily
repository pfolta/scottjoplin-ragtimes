\version "2.26.0"
\language "english"

\bookpart {
    \label #'ragtimes.peacherine-rag
    \pdf-bookmark "ragtimes.peacherine-rag" \peacherine-rag-title #0

    \peacherine-rag-header

    \score {
        \keepWithTag #'layout {
            \peacherine-rag-score
        }

        \layout {}
    }
}
