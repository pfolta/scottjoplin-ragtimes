\version "2.26.0"
\language "english"

\bookpart {
    \label #'ragtimes.maple-leaf-rag
    \pdf-bookmark "ragtimes.maple-leaf-rag" \maple-leaf-rag-title #0

    \maple-leaf-rag-header

    \score {
        \keepWithTag #'layout {
            \maple-leaf-rag-score
        }

        \layout {}
    }
}
