\version "2.26.0"
\language "english"

\paper {
    #(set-paper-size "a4")

    % The book is double-sided.
    two-sided = ##t
    binding-offset = 5
    inner-margin = 10
    outer-margin = 10
    top-margin = 10
    bottom-margin = 10

    % Stretch score systems to use the full page height on all pages.
    ragged-bottom = ##f
    ragged-last-bottom = ##f
}
